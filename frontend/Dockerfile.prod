FROM node:22-alpine AS base
# pnpm fijo: 'npm i -g pnpm' sin versión trae latest, que exige Node >= 22.13
# (usa node:sqlite) y ya rompió un build. Debe coincidir con el pnpm local
# que genera el lock; si se sube pnpm, subir también la imagen node.
RUN npm install -g pnpm@11.24.0

FROM base AS deps
WORKDIR /app
COPY package.json pnpm-lock.yaml .npmrc ./
# --ignore-scripts: no correr lifecycle scripts de deps. pnpm 11 aborta
# (ERR_PNPM_IGNORED_BUILDS) si hay build scripts sin aprobar, y el mecanismo
# de aprobación por pnpm-workspace.yaml no es fiable en build no interactivo.
# canvas -> aliaseada a false en next.config.ts; sharp -> binarios prebuilt.
RUN pnpm install --frozen-lockfile --ignore-scripts

FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
# Config de cliente (NEXT_PUBLIC_*): la lee `next build` de frontend/.env.production
# (gitignoreado, vive en la maquina que buildea). Agregar una var nueva = editar
# ese archivo, nada aqui.
# Server-side: destino del rewrite /proxy/* -> backend interno. Se puede
# sobrescribir en runtime desde Dokploy.
ARG BACKEND_URL=http://backend:8000
ENV BACKEND_URL=${BACKEND_URL}
RUN pnpm run build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs
COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
USER nextjs
EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
CMD ["node", "server.js"]
